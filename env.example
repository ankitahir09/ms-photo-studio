# Environment Variables Template
# Copy this file to .env.local for development or set these in Vercel dashboard for production

# Database
MONGO_URI=mongodb://localhost:27017/ms-photo-studio
# Production example: MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# Authentication Secret & Credentials
BETTER_AUTH_SECRET=your-super-secret-jwt-key-here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=$2b$10$your-bcrypt-hashed-password-here

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# EmailJS (Client Side)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your-emailjs-service-id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your-emailjs-template-id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your-emailjs-public-key

# Google Analytics (Client Side)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Public App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
